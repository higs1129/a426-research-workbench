<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/codexWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Codex"
            android:src="@drawable/ic_codex" />

        <TextView
            android:id="@+id/codexWidgetTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="Codex · A426"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/codexWidgetTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:text="等待同步"
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codexTaskRow1"
        style="@style/CodexTaskRow">
        <TextView android:id="@+id/codexTaskTitle1" style="@style/CodexTaskTitle" />
        <TextView android:id="@+id/codexTaskStatus1" style="@style/CodexTaskStatus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codexTaskRow2"
        style="@style/CodexTaskRow">
        <TextView android:id="@+id/codexTaskTitle2" style="@style/CodexTaskTitle" />
        <TextView android:id="@+id/codexTaskStatus2" style="@style/CodexTaskStatus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codexTaskRow3"
        style="@style/CodexTaskRow">
        <TextView android:id="@+id/codexTaskTitle3" style="@style/CodexTaskTitle" />
        <TextView android:id="@+id/codexTaskStatus3" style="@style/CodexTaskStatus" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/codexTaskRow4"
        style="@style/CodexTaskRow">
        <TextView android:id="@+id/codexTaskTitle4" style="@style/CodexTaskTitle" />
        <TextView android:id="@+id/codexTaskStatus4" style="@style/CodexTaskStatus" />
    </LinearLayout>
</LinearLayout>
